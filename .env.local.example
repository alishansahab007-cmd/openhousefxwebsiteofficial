# Required for the /start-a-listing lead form to actually send email.
# Sign up at https://resend.com, create an API key, and paste it below.
RESEND_API_KEY=

# Optional overrides — sensible defaults are used if omitted.
# Recipient for new leads (defaults to info@openhousefx.com).
# LEAD_TO_EMAIL=info@openhousefx.com
# Sender address. The default (onboarding@resend.dev) works immediately
# with no setup, but for production you should verify your own domain in
# Resend and send from an address on it, e.g. "OpenHouseFX <leads@openhousefx.com>".
# LEAD_FROM_EMAIL=OpenHouseFX Leads <onboarding@resend.dev>
